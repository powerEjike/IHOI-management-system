# Optional. Leave blank for local development; set to the canonical origin at launch.
NEXT_PUBLIC_SITE_URL=
# Firebase web app configuration (public identifiers, not server secrets).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Must match NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=(default)
# Enable only after server credentials, staff approval, and MFA setup are verified.
FIREBASE_ADMIN_ENABLED=false
# Server-only Application Default Credentials: point to a private file outside Git.
# Leave unset when the hosting runtime supplies Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=

# Server-only random secret (at least 32 characters) for public form abuse protection.
PUBLIC_FORM_RATE_LIMIT_SECRET=
# Set only to an IP header overwritten by your trusted hosting proxy, e.g. x-real-ip.
# Required in production before enabling public forms. Leave blank for local previews.
PUBLIC_FORM_PROXY_HEADER=

# Optional Vercel production: Google Workload Identity Federation (no private key).
FIREBASE_CREDENTIAL_MODE=
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=

{
  "name": "ihoi-management-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.mts *.mjs *.json",
    "format:check": "prettier --check src tests scripts *.ts *.mts *.mjs *.json"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "firebase": "13.2.0",
    "firebase-admin": "14.5.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "firebase-tools": "15.35.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
